{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Store Builder Input",
  "type": "object",
  "required": ["pain", "product", "country", "competition", "store_blueprint"],
  "properties": {
    "pain": {
      "type": "object",
      "required": ["approved"],
      "properties": {
        "approved": {"const": true},
        "name": {"type": "string"},
        "voice_of_customer": {"type": "array", "items": {"type": "string"}}
      }
    },
    "product": {
      "type": "object",
      "required": ["approved", "name"],
      "properties": {
        "approved": {"const": true},
        "name": {"type": "string"},
        "mechanism": {"type": "string"},
        "landed_cost": {"type": ["number", "null"]},
        "variants": {"type": "array"}
      }
    },
    "country": {
      "type": "object",
      "required": ["approved", "code", "locale", "currency"],
      "properties": {
        "approved": {"const": true},
        "code": {"type": "string"},
        "locale": {"type": "string"},
        "currency": {"type": "string"}
      }
    },
    "competition": {
      "type": "object",
      "required": ["approved", "verdict"],
      "properties": {
        "approved": {"const": true},
        "verdict": {"enum": ["GO", "CONDITIONAL_GO"]},
        "angle_gap": {"type": "string"},
        "offer_gap": {"type": "string"}
      }
    },
    "store_blueprint": {
      "type": "object",
      "required": ["approved", "brand", "offer", "landing_page"],
      "properties": {
        "approved": {"const": true},
        "brand": {"type": "object"},
        "offer": {"type": "object"},
        "landing_page": {"type": "object"}
      }
    }
  }
}
